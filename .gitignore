# Only src/ and results/ are tracked. Everything else is local or lives on the
# cluster (hpc2.storrs.hpc.uconn.edu:~/cancer), which mirrors this layout.

# --- macOS / editor noise ---
.DS_Store
*.swp

# --- Python ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# --- Simulation data: 21 GB on the cluster, a partial subset here. Never in git.
# Leading slash matters: a bare 'data/' would also match src/cancer_sbi/data/.
/data/
Guassian_Normal/
Guassian_Normal_all/
Laplace_pos/
numpy_data*/
simulation_outputs/
*.pkl.gz

# --- Model weights: 2 GB, cluster-only, backed up separately ---
/runs/
checkpoints*/
*.pt

# --- Posterior sample dumps: ~530 MB each, regenerate with jobs/sample.sh ---
results/posteriors/

# --- Local-only working areas ---
/docs/
# overview_figure/ is local EXCEPT the poster deliverables: the poster source, the
# figure files it references and a PDF exported from that same file (2026-09-28).
/overview_figure/*
!/overview_figure/poster/
/overview_figure/poster/*
!/overview_figure/poster/poster_body.html
!/overview_figure/poster/poster_NECB_2026.pdf
!/overview_figure/poster/panels/
/overview_figure/poster/panels/*
!/overview_figure/poster/panels/panel_ab.png
!/overview_figure/poster/panels/panel_c.png
!/overview_figure/poster/panels/panel_d.png
!/overview_figure/poster/panels/panel_e.png
!/overview_figure/poster/panels/panel_f.png
!/overview_figure/poster/panels/panel_g.png
!/overview_figure/poster/panels/panel_m.png
!/overview_figure/poster/panels/qr_paper.svg
!/overview_figure/poster/panels/uconn_logo.png
/logs/
/cache/

# --- Superseded, pending deletion after the 2026-10-01 poster deadline ---
_archive_*/
_superseded_*/
